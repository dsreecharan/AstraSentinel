# These defaults match the two loopback servers in the README.
ASTRA_FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Relative paths are resolved from the workspace root.
ASTRA_DB_PATH=data/astra.sqlite3
ASTRA_MEDIA_DIR=data/demo_video
ASTRA_MODEL_WEIGHTS=data/weights/yolo26n.pt
ASTRA_ANALYSIS_CONFIG=

# Set a private token in .env to enable writes for the local operator.
ASTRA_OPERATOR_NAME=local-operator
ASTRA_OPERATOR_TOKEN=

# Fill these in before running python -m app.seed_source.
ASTRA_SOURCE_ID=demo-aerial
ASTRA_SOURCE_TITLE=
ASTRA_SOURCE_VIDEO_PATH=
ASTRA_SOURCE_RIGHTS_NOTE=
ASTRA_SOURCE_ATTRIBUTION=
ASTRA_SOURCE_LICENSE_URL=
